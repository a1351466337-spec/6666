<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <RootNamespace>TartarusAndroid</RootNamespace>
    <AssemblyName>TartarusAndroid</AssemblyName>
    <ApplicationId>com.tartarus.helper</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidLinkMode>None</AndroidLinkMode>
    <RunAOTCompilation>false</RunAOTCompilation>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The original app's vision, rules and solver, as they are (cloned to ../upstream by the workflow). -->
  <ItemGroup>
    <ProjectReference Include="../upstream/src/Tartarus.Rules/Tartarus.Rules.csproj" />
    <ProjectReference Include="../upstream/src/Tartarus.Solver/Tartarus.Solver.csproj" />
    <ProjectReference Include="../upstream/src/Tartarus.Vision/Tartarus.Vision.csproj" />
  </ItemGroup>

  <!-- Two plain classes of the original WPF app (no UI in them): the scanner thread and the move search. -->
  <ItemGroup>
    <Compile Include="../upstream/src/Tartarus.App/ScanService.cs" Link="Upstream/ScanService.cs" />
    <Compile Include="../upstream/src/Tartarus.App/HintService.cs" Link="Upstream/HintService.cs" />
  </ItemGroup>

  <!-- The models (networks, pictures, texts, Chinese + English OCR) travel inside the APK and are unpacked on first start. -->
  <ItemGroup>
    <AndroidAsset Include="../upstream/models/**/*"
                  Exclude="../upstream/models/ocr/*eslav*;../upstream/models/ocr/*korean*;../upstream/models/ocr/*thai*;../upstream/models/ocr/*latin*"
                  Link="Assets/models/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
