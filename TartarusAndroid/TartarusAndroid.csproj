<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <RootNamespace>TartarusAndroid</RootNamespace>
    <AssemblyName>TartarusAndroid</AssemblyName>
    <ApplicationId>com.tartarus.helper</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidLinkMode>None</AndroidLinkMode>
    <RunAOTCompilation>false</RunAOTCompilation>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Android's implicit usings clash with the original code's names (GameState, ...): none of them. -->
  <ItemGroup>
    <Using Remove="Android.App" />
    <Using Remove="Android.Content" />
    <Using Remove="Android.OS" />
    <Using Remove="Android.Runtime" />
    <Using Remove="Android.Views" />
    <Using Remove="Android.Widget" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../upstream/src/Tartarus.Rules/Tartarus.Rules.csproj" />
    <ProjectReference Include="../upstream/src/Tartarus.Solver/Tartarus.Solver.csproj" />
    <ProjectReference Include="../upstream/src/Tartarus.Vision/Tartarus.Vision.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../upstream/src/Tartarus.App/ScanService.cs" Link="Upstream/ScanService.cs" />
    <Compile Include="../upstream/src/Tartarus.App/HintService.cs" Link="Upstream/HintService.cs" />
  </ItemGroup>

  <ItemGroup>
    <AndroidAsset Include="../upstream/models/**/*" Link="Assets/models/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Remove="../upstream/models/ocr/*eslav*" />
    <AndroidAsset Remove="../upstream/models/ocr/*korean*" />
    <AndroidAsset Remove="../upstream/models/ocr/*thai*" />
    <AndroidAsset Remove="../upstream/models/ocr/*latin*" />
  </ItemGroup>
</Project>
